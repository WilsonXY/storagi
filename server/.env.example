# Register EXACT https://your-host/auth/callback on a Google Web application client.
PUBLIC_ORIGIN=https://your-host.example
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Verified Google sub from the separate loopback enrollment CLI. Never first visitor.
OWNER_GOOGLE_SUB=
# Required absolute path to a dedicated private directory, outside web/dist.
DATA_DIR=/var/lib/storagi
# Bind is always 127.0.0.1; HTTPS is terminated by the separately approved proxy.
PORT=8787
BUDGET_BYTES=214748364800
DISK_RESERVE_BYTES=1073741824

# Inactive system service template; review docs/setup.md before installation.
# Prerequisites: storagi account/group, built /opt/storagi, private environment and data directories.
[Unit]
Description=Storagi temporary file shelf
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=storagi
Group=storagi
WorkingDirectory=/opt/storagi/server
EnvironmentFile=/etc/storagi/environment
ExecStart=/usr/bin/node /opt/storagi/server/dist/src/main.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/storagi

[Install]
WantedBy=multi-user.target

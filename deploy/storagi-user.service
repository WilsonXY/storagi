# User-manager service; follow docs/user-service.md before installation.
[Unit]
Description=Storagi temporary file shelf (owner user)
# Retry startup discovery through network outages without exhausting a start limit.
StartLimitIntervalSec=0

[Service]
Type=exec
WorkingDirectory=%h/.local/lib/storagi/current/server
EnvironmentFile=%h/.config/storagi/environment
# Refuse to start a release that scripts/deploy.sh did not stamp or that changed since.
ExecStartPre=%h/.local/lib/storagi/current/scripts/verify-release.sh
ExecStart=/usr/bin/node %h/.local/lib/storagi/current/server/dist/src/main.js
Restart=on-failure
RestartSec=15s
TimeoutStopSec=60s
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target

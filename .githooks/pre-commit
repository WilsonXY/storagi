#!/bin/sh
# Formats staged files with the repository's Prettier, covering the same files as `npm run format`.
# Installed by `npm run setup`. Re-stages each formatted file whole.
set -eu
# In a Git pathspec `*` also matches `/`, so `server/*.ts` is `server/**/*.ts`.
set --
for dir in server web scripts; do
  for ext in ts js mjs css html; do set -- "$@" "$dir/*.$ext"; done
done
git diff --cached --quiet --diff-filter=ACMR -- "$@" && exit 0
prettier=node_modules/.bin/prettier
[ -x "$prettier" ] || { echo 'pre-commit: Prettier is missing; run npm run setup' >&2; exit 1; }
staged() { git diff --cached --name-only -z --diff-filter=ACMR -- "$@"; }
staged "$@" | xargs -0 "$prettier" --write --log-level warn
staged "$@" | xargs -0 git --literal-pathspecs add --
